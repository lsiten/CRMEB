    "@tarojs/react": "^4.2.1",
    "@tarojs/runtime": "^4.2.1",
    "@tarojs/shared": "^4.2.1",
    "@tarojs/taro": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.3",
    "@tarojs/cli": "^4.2.1",
    "@tarojs/plugin-framework-react": "^4.2.1",
    "@tarojs/plugin-platform-weapp": "^4.2.1",
    "@tarojs/plugin-platform-h5": "^4.2.1",
    "@tarojs/webpack5-runner": "^4.2.1",
    "babel-preset-taro": "^4.2.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-test-renderer": "^18.3.1",
    "react-refresh": "0.18.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
